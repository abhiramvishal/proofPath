# Database
DATABASE_URL=postgresql+asyncpg://proofpath:proofpath@localhost:5432/proofpath
DATABASE_URL_SYNC=postgresql://proofpath:proofpath@localhost:5432/proofpath

# Redis
REDIS_URL=redis://localhost:6379/0

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=

# Anthropic (report generation)
ANTHROPIC_API_KEY=

# API
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# PAID signing (production: AWS KMS)
PAID_SIGNING_KEY_PATH=./keys/paid_private.pem
PAID_VERIFICATION_KEY_PATH=./keys/paid_public.pem

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VERIFY_URL=http://localhost:3000/verify
